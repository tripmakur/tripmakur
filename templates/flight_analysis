{% extends "base.html" %}
{% block content %}

<!-- Top nav for status/analysis -->
<div class="tm-card" style="margin-bottom: 10px;">
    <a href="{{ url_for('flight_status', company=company) }}">Flight Status</a> |
    <a href="{{ url_for('flight_analysis', company=company) }}">Flight Analysis</a>
</div>

<div class="tm-card">
    <h2>Flight Analysis</h2>
    <p><strong>Company:</strong> {{ company or "N/A" }}</p>
    <p>Enter up to 10 origin airports and up to 3 destination airports. The tool will price the least expensive roundtrip between each origin and destination using the Amadeus API.</p>
</div>

<div class="tm-card">
    <h3>Input Parameters</h3>
    <form method="POST" action="{{ url_for('flight_analysis', company=company) }}">
        <input type="hidden" name="company" value="{{ company }}">

        <div class="tm-flex">
            <div class="tm-flex-item">
                <h4>Origin Airports (up to 10)</h4>
                {% for i in range(1, 11) %}
                <div class="tm-field">
                    <label>Origin {{ i }}</label>
                    <input type="text" name="origin{{ i }}" placeholder="e.g. ATL">
                </div>
                {% endfor %}
            </div>

            <div class="tm-flex-item">
                <h4>Destination Airports (up to 3)</h4>
                {% for j in range(1, 4) %}
                <div class="tm-field">
                    <label>Destination {{ j }}</label>
                    <input type="text" name="dest{{ j }}" placeholder="e.g. LAX">
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="tm-flex">
            <div class="tm-flex-item">
                <div class="tm-field">
                    <label>Outbound Date (YYYY-MM-DD)</label>
                    <input type="text" name="outbound_date" placeholder="2025-11-14">
                </div>
            </div>
            <div class="tm-flex-item">
                <div class="tm-field">
                    <label>Return Date (YYYY-MM-DD)</label>
                    <input type="text" name="return_date" placeholder="2025-11-20">
                </div>
            </div>
        </div>

        <button type="submit" class="tm-btn tm-btn-primary">Run Analysis</button>
    </form>
</div>

{% if analysis_results %}
<div class="tm-card">
    <h3>Analysis Results</h3>
    <table class="tm-table">
        <thead>
            <tr>
                <th>Origin</th>
                <th>Destination</th>
                <th>Outbound Date</th>
                <th>Return Date</th>
                <th>Lowest Price</th>
                <th>Currency</th>
                <th>Error</th>
            </tr>
        </thead>
        <tbody>
            {% for row in analysis_results %}
            <tr>
                <td>{{ row.Origin }}</td>
                <td>{{ row.Destination }}</td>
                <td>{{ row.DepartureDate }}</td>
                <td>{{ row.ReturnDate }}</td>
                <td>{{ row.Price or "-" }}</td>
                <td>{{ row.Currency }}</td>
                <td>{{ row.Error }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <form method="GET" action="{{ url_for('download_analysis_excel') }}">
        <button type="submit" class="tm-btn tm-btn-primary" style="margin-top:10px;">
            Download Results as Excel
        </button>
    </form>
</div>
{% endif %}

{% endblock %}
